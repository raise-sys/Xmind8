    [JSInvokable]
    public Task BeginRangeSelection(double x, double y)
    {
        RangeSelectionBaseIds = SelectedNodeIds.ToHashSet();
        RangeSelectionBaseActiveId = SelectedId;
        RangeSelectionStartX = RangeSelectionCurrentX = x;
        RangeSelectionStartY = RangeSelectionCurrentY = y;
        IsRangeSelecting = true;
        SuppressNextCanvasClick = true;
        Status = "範囲をドラッグして複数選択します";
        StateHasChanged();
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task UpdateRangeSelection(double x, double y)
    {
        if (!IsRangeSelecting) return Task.CompletedTask;
        RangeSelectionCurrentX = x;
        RangeSelectionCurrentY = y;

        SelectedNodeIds.Clear();
        SelectedNodeIds.UnionWith(RangeSelectionBaseIds);
        var nodesInRange = VisibleNodes.Where(NodeIntersectsRangeSelection).ToList();
        SelectedNodeIds.UnionWith(nodesInRange.Select(node => node.Id));
        SelectedId = nodesInRange.LastOrDefault()?.Id
            ?? (RangeSelectionBaseActiveId is not null && SelectedNodeIds.Contains(RangeSelectionBaseActiveId.Value)
                ? RangeSelectionBaseActiveId
                : Nodes.LastOrDefault(node => SelectedNodeIds.Contains(node.Id))?.Id);
        Status = SelectedNodeIds.Count == 0
            ? "範囲内にトピックがありません"
            : $"{SelectedNodeIds.Count}個のトピックを選択しています";
        StateHasChanged();
        return Task.CompletedTask;
    }

    private bool NodeIntersectsRangeSelection(MindNode node)
    {
        var right = RangeSelectionX + RangeSelectionWidth;
        var bottom = RangeSelectionY + RangeSelectionHeight;
        return node.X < right && node.X + NodeWidth(node) > RangeSelectionX &&
               node.Y < bottom && node.Y + NodeHeight(node) > RangeSelectionY;
    }

    [JSInvokable]
    public Task EndRangeSelection()
    {
        IsRangeSelecting = false;
        Status = SelectedNodeIds.Count == 0
            ? "トピックを選択してください"
            : SelectedNodeIds.Count == 1
                ? "1個のトピックを選択しています"
                : $"{SelectedNodeIds.Count}個のトピックを選択しています";
        StateHasChanged();
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task SetCanvasView(double x, double y)
    {
        ViewX = x;
        ViewY = y;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void ChangeZoom(ChangeEventArgs e)
    {
        if (!double.TryParse(e.Value?.ToString(), out var percent)) return;
        var centerX = ViewX + ViewWidth / 2;
        var centerY = ViewY + ViewHeight / 2;
        Zoom = Math.Clamp(percent / 100, .4, 2.5);
        ViewX = centerX - ViewWidth / 2;
        ViewY = centerY - ViewHeight / 2;
        if (EditingNodeId is not null) { FocusEditorPending = true; }
    }

    private void ResetViewport()
    {
        Zoom = 1;
        ViewX = 0;
        ViewY = 0;
        if (EditingNodeId is not null) FocusEditorPending = true;
        Status = "表示位置と倍率を元に戻しました";
    }

    [JSInvokable]
    public Task MoveDraggedNode(string id, double x, double y)
    {
        if (Guid.TryParse(id, out var nodeId) && Find(nodeId) is { } node)
        {
            node.X = x;
            node.Y = y;
            ConnectingTargetId = FindConnectionTarget(node)?.Id;
            Status = ConnectingTargetId is null
                ? "ドラッグしてトピックを移動できます"
                : "ここで離すとセルを接続します";
            StateHasChanged();
        }
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task EndNodeDrag()
    {
        var dragged = DraggingNodeId is null ? null : Find(DraggingNodeId.Value);
        var target = ConnectingTargetId is null ? null : Find(ConnectingTargetId.Value);
        if (dragged is not null && target is not null && dragged.Id != RootId)
        {
            dragged.ParentId = target.Id;
            Status = "セルをコネクターで接続しました";
        }
        else
        {
            Status = "トピックを移動しました";
        }
        DraggingNodeId = null;
        ConnectingTargetId = null;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private MindNode? FindConnectionTarget(MindNode dragged)
    {
        if (dragged.Id == RootId) return null;
        var draggedLeft = dragged.X;
        var draggedRight = dragged.X + NodeWidth(dragged);
        var draggedCenterY = dragged.Y + NodeHeight(dragged) / 2;
        var invalidTargets = DescendantIds(dragged.Id);

        return Nodes.Where(target => target.Id != dragged.Id && !invalidTargets.Contains(target.Id))
            .Select(target => new
            {
                Node = target,
                EdgeDistance = Math.Min(
                    Math.Abs(draggedRight - target.X),
                    Math.Abs(draggedLeft - (target.X + NodeWidth(target)))),
                CenterDistance = Math.Abs(draggedCenterY - (target.Y + NodeHeight(target) / 2))
            })
            .Where(candidate => candidate.EdgeDistance <= 55 && candidate.CenterDistance <= 75)
            .OrderBy(candidate => candidate.EdgeDistance + candidate.CenterDistance * .25)
            .Select(candidate => candidate.Node)
            .FirstOrDefault();
    }
    private void UpdateText(MindNode node, string? text) => node.Text = text ?? "";
    private void RemoveImage(MindNode node) { node.ImageDataUrl = null; ReflowLogicTree(); Status = "画像を削除しました"; }
    private void UpdateSelectedText(string? text) { if (SelectedNode is not null) SelectedNode.Text = text ?? ""; }
    private void RemoveSelectedImage() { if (SelectedNode is not null) RemoveImage(SelectedNode); }
    private static string DisplayText(string text) => string.Join("\n", text.Replace("\r", "").Split('\n').Select(line => line.Length <= 22 ? line : $"{line[..21]}…"));
    private static MarkupString SvgText(string cssClass, double x, double y, string value, double lineHeight,
        string? fill = null, double? fontSize = null, string? fontWeight = null, string textAnchor = "middle")
    {
        var sx = x.ToString(System.Globalization.CultureInfo.InvariantCulture);
        var sy = y.ToString(System.Globalization.CultureInfo.InvariantCulture);
        var lineOffset = lineHeight.ToString(System.Globalization.CultureInfo.InvariantCulture);
        var spans = new System.Text.StringBuilder();
        var lines = value.Replace("\r", "").Split('\n');
        for (var index = 0; index < lines.Length; index++)
        {
            var dy = index == 0 ? "" : " dy=\"" + lineOffset + "\"";
            spans.Append("<tspan x=\"").Append(sx).Append("\"").Append(dy).Append(">")
                .Append(System.Text.Encodings.Web.HtmlEncoder.Default.Encode(lines[index])).Append("</tspan>");
        }
        var fillAttribute = fill is null ? "" : $" fill=\"{fill}\"";
        var fontSizeAttribute = fontSize is null ? "" : $" font-size=\"{fontSize.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)}px\"";
        var fontWeightAttribute = fontWeight is null ? "" : $" font-weight=\"{fontWeight}\"";
        return new MarkupString($"<text class=\"{cssClass}\"{fillAttribute}{fontSizeAttribute}{fontWeightAttribute} x=\"{sx}\" y=\"{sy}\" text-anchor=\"{textAnchor}\">{spans}</text>");
    }

    private async Task BeginEdit(MindNode node)
    {
        SelectOnly(node.Id);
        EditingNodeId = node.Id;
        EditOriginalText = node.Text;
        EditOriginalWidth = NodeWidth(node);
        FocusEditorPending = true;
        Status = "編集モード：文字を入力し、Enterで確定します";
        await InvokeAsync(StateHasChanged);
    }

    private async Task BeginEditByTyping(MindNode node, string initialText)
    {
        SelectedBadgeNodeId = null;
        ImageSelectedNodeId = null;
        SelectOnly(node.Id);
        EditingNodeId = node.Id;
        EditOriginalText = node.Text;
        EditOriginalWidth = NodeWidth(node);
        node.Text = initialText;
        FocusEditorPending = true;
        Status = "編集モード：文字を入力し、Enterで確定します";
        await InvokeAsync(StateHasChanged);
    }

    private void UpdateEditingText(string? text)
    {
        if (EditingNode is not null) EditingNode.Text = text ?? "";
    }

    private void EndEdit(bool convertLink = true)
    {
        if (convertLink && EditingNode is { } node)
        {
            ConvertTextUrlToLink(node);
            NormalizeLayoutAfterEdit(node);
        }
        EditingNodeId = null;
        FocusEditorPending = false;
        Status = "閲覧モード：ドラッグで移動できます";
    }

    private void NormalizeLayoutAfterEdit(MindNode node)
    {
        if (LayoutMode == "logic")
        {
            ReflowLogicTree();
            return;
        }
        // 横幅が変わってもセルの中心位置を維持する。
        var newWidth = NodeWidth(node);
        node.X -= (newWidth - EditOriginalWidth) / 2;

        if (node.ParentId is not null && Find(node.ParentId.Value) is { } parent)
        {
            EnsureParentChildGap(parent, node);
            ResolveSiblingSpacing(parent);
        }

        foreach (var child in Nodes.Where(candidate => candidate.ParentId == node.Id).ToList())
            EnsureParentChildGap(node, child);
        ResolveSiblingSpacing(node);
    }

    private void EnsureParentChildGap(MindNode parent, MindNode child)
    {
        const double minimumGap = 70;
        var parentCenterX = parent.X + NodeWidth(parent) / 2;
        var childCenterX = child.X + NodeWidth(child) / 2;
        if (childCenterX >= parentCenterX)
        {
            var minimumX = parent.X + NodeWidth(parent) + minimumGap;
            if (child.X < minimumX) MoveSubtree(child.Id, minimumX - child.X, 0);
        }
        else
        {
            var maximumRight = parent.X - minimumGap;
            var childRight = child.X + NodeWidth(child);
            if (childRight > maximumRight) MoveSubtree(child.Id, maximumRight - childRight, 0);
        }
    }

    private void ResolveSiblingSpacing(MindNode parent)
    {
        var parentCenterX = parent.X + NodeWidth(parent) / 2;
        var children = Nodes.Where(candidate => candidate.ParentId == parent.Id).ToList();
        foreach (var side in children.GroupBy(child => child.X + NodeWidth(child) / 2 >= parentCenterX))
        {
            MindNode? previous = null;
            foreach (var child in side.OrderBy(candidate => candidate.Y))
            {
                if (previous is not null)
                {
                    var minimumY = previous.Y + NodeHeight(previous) + 18;
                    if (child.Y < minimumY) MoveSubtree(child.Id, 0, minimumY - child.Y);
                }
                previous = child;
            }
        }
    }

    private void MoveSubtree(Guid nodeId, double deltaX, double deltaY)
    {
        foreach (var id in DescendantIds(nodeId))
        {
            if (Find(id) is not { } item) continue;
            item.X += deltaX;
            item.Y += deltaY;
        }
    }

    private void CancelEdit()
    {
        if (EditingNode is not null) EditingNode.Text = EditOriginalText;
        EndEdit(false);
    }

    private void ConvertTextUrlToLink(MindNode node)
    {
        var match = System.Text.RegularExpressions.Regex.Match(node.Text,
            @"https?://[^\s<>""']+", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        if (!match.Success) return;
        var url = match.Value.TrimEnd('.', ',', ';', ')', ']', '}');
        node.LinkUrl = url;
        node.YoutubeUrl = null;
        node.Text = (node.Text[..match.Index] + node.Text[(match.Index + match.Length)..]).Trim();
        Status = IsYoutubeLink(url) ? "YouTubeリンクをアイコンへ変換しました" : "URLをリンクアイコンへ変換しました";
    }

    private void EditorKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && (e.AltKey || e.ShiftKey)) return;
        if (e.Key == "Enter") EndEdit();
        else if (e.Key == "Escape") CancelEdit();
    }

    [JSInvokable]
    public async Task HandleShortcut(string key)
    {
        if (EditingNodeId is not null) return;
        if (SelectedNode is null) return;
        if (key.StartsWith("Type:", StringComparison.Ordinal))
        {
            await BeginEditByTyping(SelectedNode, key[5..]);
            return;
        }
        if (key == "Delete" && SelectedBadgeNodeId is not null && SelectedNode?.Id == SelectedBadgeNodeId)
        {
            SelectedNode.Priority = 0;
            SelectedBadgeNodeId = null;
            Status = "優先度バッジを削除しました";
            StateHasChanged();
            return;
        }
        if (ImageSelectedNodeId is not null && SelectedNode?.Id == ImageSelectedNodeId)
        {
            if (key == "AltArrowUp")
            {
                SelectedNode.ImageAboveText = true;
                Status = "画像をテキストの上へ移動しました";
                StateHasChanged();
                return;
            }
            if (key == "AltArrowDown")
            {
                SelectedNode.ImageAboveText = false;
                Status = "画像をテキストの下へ移動しました";
                StateHasChanged();
                return;
            }
            if (key == "Delete")
            {
                SelectedNode.ImageDataUrl = null;
                ImageSelectedNodeId = null;
                ReflowLogicTree();
                Status = "画像を削除しました";
                StateHasChanged();
                return;
            }
        }
        if (key is not ("Ctrl1" or "Ctrl2" or "Ctrl3" or "Ctrl4" or "Ctrl5" or "Ctrl6"))
        {
            SelectedBadgeNodeId = null;
            if (key is not ("AltArrowUp" or "AltArrowDown")) ImageSelectedNodeId = null;
        }
        switch (key)
        {
            case "F2": await BeginEdit(SelectedNode!); break;
            case "Enter": AddSibling(); StateHasChanged(); break;
            case "Tab": AddChild(); StateHasChanged(); break;
            case "Delete": DeleteSelected(); StateHasChanged(); break;
            case "Ctrl1": SetPriority(1); StateHasChanged(); break;
            case "Ctrl2": SetPriority(2); StateHasChanged(); break;
            case "Ctrl3": SetPriority(3); StateHasChanged(); break;
            case "Ctrl4": SetPriority(4); StateHasChanged(); break;
            case "Ctrl5": SetPriority(5); StateHasChanged(); break;
            case "Ctrl6": SetPriority(6); StateHasChanged(); break;
            case "ArrowUp": SelectSibling(true); StateHasChanged(); break;
            case "ArrowDown": SelectSibling(false); StateHasChanged(); break;
            case "ArrowLeft": SelectParentOrChild(false); StateHasChanged(); break;
            case "ArrowRight": SelectParentOrChild(true); StateHasChanged(); break;
            case "AltArrowUp": ReorderSibling(true); StateHasChanged(); break;
            case "AltArrowDown": ReorderSibling(false); StateHasChanged(); break;
            case "AltArrowLeft": SwapParentChild(false); StateHasChanged(); break;
            case "AltArrowRight": SwapParentChild(true); StateHasChanged(); break;
        }
    }

