    private async Task LoadImageFile(InputFileChangeEventArgs e)
    {
        if (SelectedNode is null) { Status = "先に貼り付け先のトピックを選択してください"; return; }
        try
        {
            var file = e.File;
            using var stream = file.OpenReadStream(15 * 1024 * 1024);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            SelectedNode.ImageDataUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(memory.ToArray())}";
            ReflowLogicTree();
            Status = "画像を読み込みました";
        }
        catch (Exception ex) { Status = $"画像を読み込めません: {ex.Message}"; }
    }

    private string Serialize()
    {
        SaveLayoutPositions(LayoutMode);
        SaveCurrentModeZoom();
        return JsonSerializer.Serialize(new MindMapDocument {
            RootId = RootId,
            Nodes = Nodes,
            LayoutMode = LayoutMode,
            MindZoom = MindZoom,
            LogicZoom = LogicZoom
        }, JsonOptions);
    }
    private void UpdateDocumentName(ChangeEventArgs e) => DocumentName = e.Value?.ToString() ?? "";
    private void UpdateSelectedFolderFile(ChangeEventArgs e) => SelectedFolderFile = e.Value?.ToString() ?? "";
    private async Task SaveToBrowser() { await JS.InvokeVoidAsync("mindCanvas.saveLocal", Serialize()); Status = "このブラウザに保存しました"; }
    private async Task Download() => await JS.InvokeVoidAsync("mindCanvas.download", "mind-map.json", Serialize());
    private async Task SelectSaveFolder()
    {
        try
        {
            SaveFolderName = await JS.InvokeAsync<string>("mindCanvas.selectFolder");
            await RefreshFolderFiles();
            Status = $"保存先フォルダ「{SaveFolderName}」を選択しました";
        }
        catch (JSException ex) { Status = $"フォルダを選択できません: {ex.Message}"; }
    }

    private async Task RefreshFolderFiles()
    {
        if (string.IsNullOrWhiteSpace(SaveFolderName)) return;
        try
        {
            FolderFiles = (await JS.InvokeAsync<string[]>("mindCanvas.listFolderFiles")).ToList();
            if (!FolderFiles.Contains(SelectedFolderFile)) SelectedFolderFile = "";
        }
        catch (JSException ex) { Status = $"ファイル一覧を取得できません: {ex.Message}"; }
    }

    private async Task SaveToFolder()
    {
        if (string.IsNullOrWhiteSpace(SaveFolderName)) return;
        var name = string.IsNullOrWhiteSpace(DocumentName) ? "mind-map" : DocumentName.Trim();
        if (!name.EndsWith(".json", StringComparison.OrdinalIgnoreCase)) name += ".json";
        try
        {
            await JS.InvokeVoidAsync("mindCanvas.saveToFolder", name, Serialize());
            DocumentName = Path.GetFileNameWithoutExtension(name);
            SelectedFolderFile = name;
            await RefreshFolderFiles();
            SelectedFolderFile = name;
            Status = $"{name} を保存しました";
        }
        catch (JSException ex) { Status = $"保存できません: {ex.Message}"; }
    }

    private async Task LoadFromFolder()
    {
        if (string.IsNullOrWhiteSpace(SelectedFolderFile)) return;
        try
        {
            var json = await JS.InvokeAsync<string>("mindCanvas.loadFromFolder", SelectedFolderFile);
            LoadJson(json);
            DocumentName = Path.GetFileNameWithoutExtension(SelectedFolderFile);
            Status = $"{SelectedFolderFile} を開きました";
        }
        catch (JSException ex) { Status = $"ファイルを開けません: {ex.Message}"; }
    }
    private async Task LoadFile(InputFileChangeEventArgs e)
    {
        using var stream = e.File.OpenReadStream(25 * 1024 * 1024);
        using var reader = new StreamReader(stream);
        LoadJson(await reader.ReadToEndAsync());
    }
    private void LoadJson(string json)
    {
        try {
            var document = JsonSerializer.Deserialize<MindMapDocument>(json, JsonOptions);
            if (document?.Nodes is not { Count: > 0 }) return;
            Nodes = document.Nodes; RootId = document.RootId; LayoutMode = document.LayoutMode is "logic" ? "logic" : "mind";
            MindZoom = NormalizeZoom(document.MindZoom);
            LogicZoom = NormalizeZoom(document.LogicZoom);
            RestoreModeZoom(LayoutMode);
            SaveLayoutPositions(LayoutMode);
            SelectOnly(RootId); Status = "マインドマップを読み込みました";
        } catch { Status = "ファイルを読み込めませんでした"; }
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("mindCanvas.dispose"); } catch { }
        SelfReference?.Dispose();
    }

    private sealed class MindMapDocument
    {
        public Guid RootId { get; set; }
        public string LayoutMode { get; set; } = "mind";
        public double MindZoom { get; set; } = 1;
        public double LogicZoom { get; set; } = 1;
        public List<MindNode> Nodes { get; set; } = [];
    }
    private sealed class MindNode
    {
        public Guid Id { get; set; } = Guid.NewGuid();
        public Guid? ParentId { get; set; }
        public string Text { get; set; } = "";
        public double X { get; set; }
        public double Y { get; set; }
        public double Width { get; set; } = 230;
        public string? ImageDataUrl { get; set; }
        public double ImageHeight { get; set; } = 207;
        public bool ImageAboveText { get; set; } = true;
        public bool IsCollapsed { get; set; }
        public int Priority { get; set; }
        public string? YoutubeUrl { get; set; }
        public string? LinkUrl { get; set; }
        public double? MindX { get; set; }
        public double? MindY { get; set; }
        public double? LogicX { get; set; }
        public double? LogicY { get; set; }
    }
