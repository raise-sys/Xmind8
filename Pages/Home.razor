@page "/"
@using System.Text.Json
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>Mind Canvas</PageTitle>

<div class="mind-app">
    <header class="toolbar">
        <div class="brand"><span class="brand-mark">M</span><span>Mind Canvas</span></div>
        <div class="tools">
            <span class="mode-badge @(EditingNodeId is null ? "view-mode" : "edit-mode")">
                @(EditingNodeId is null ? "閲覧モード" : "編集モード")
            </span>
            <div class="layout-modes">
                <button class="@(LayoutMode == "mind" ? "active" : "")" @onclick="ChangeToMindMap">マインドマップ</button>
                <button class="@(LayoutMode == "logic" ? "active" : "")" @onclick="ChangeToLogicTree">ロジックツリー</button>
            </div>
            <div class="priority-tools" title="優先度バッジ（Ctrl+1～6）">
                @for (var priority = 1; priority <= 6; priority++)
                {
                    var value = priority;
                    <button class="priority-button p@value @(SelectedNode?.Priority == value ? "active" : "")"
                            disabled="@(SelectedNode is null)" @onclick="() => SetPriority(value)">@value</button>
                }
            </div>
            <span class="separator"></span>
            <button @onclick="SaveToBrowser">保存</button>
            <label class="file-button">読込<InputFile OnChange="LoadFile" accept="application/json,.json" /></label>
            <button @onclick="Download">JSON出力</button>
        </div>
        <div class="status">@Status</div>
    </header>

    <div class="folder-toolbar">
        <button @onclick="SelectSaveFolder">📁 フォルダ選択</button>
        <span class="folder-name">@(string.IsNullOrWhiteSpace(SaveFolderName) ? "フォルダ未選択" : SaveFolderName)</span>
        <input value="@DocumentName" @oninput="UpdateDocumentName" placeholder="ファイル名" aria-label="保存ファイル名" />
        <button class="folder-save" @onclick="SaveToFolder" disabled="@string.IsNullOrWhiteSpace(SaveFolderName)">保存</button>
        <span class="separator"></span>
        <select value="@SelectedFolderFile" @onchange="UpdateSelectedFolderFile" disabled="@(FolderFiles.Count == 0)">
            <option value="">保存済みファイルを選択</option>
            @foreach (var file in FolderFiles)
            {
                <option value="@file">@file</option>
            }
        </select>
        <button @onclick="LoadFromFolder" disabled="@string.IsNullOrWhiteSpace(SelectedFolderFile)">開く</button>
        <button @onclick="RefreshFolderFiles" disabled="@string.IsNullOrWhiteSpace(SaveFolderName)" title="ファイル一覧を更新">↻</button>
    </div>

    <section class="workspace">
        <svg @ref="CanvasElement" class="canvas" viewBox="@ViewBox" preserveAspectRatio="xMidYMid meet"
             @onclick="HandleCanvasClick" @onpointerdown="StartCanvasPan" @onpointerdown:preventDefault>
            <defs>
                <filter id="shadow" x="-20%" y="-20%" width="140%" height="160%">
                    <feDropShadow dx="0" dy="4" stdDeviation="6" flood-opacity=".14" />
                </filter>
            </defs>

            @foreach (var node in VisibleNodes.Where(n => n.ParentId is not null))
            {
                var parent = Find(node.ParentId!.Value);
                if (parent is not null)
                {
                    var path = BranchPath(parent, node);
                    <path class="connector-hit" d="@path" @onclick:stopPropagation @onclick="() => DeleteConnector(node)" />
                    <path class="branch" d="@path" @onclick:stopPropagation @onclick="() => DeleteConnector(node)" />
                }
            }

            @foreach (var node in VisibleNodes)
            {
                var height = NodeHeight(node);
                var width = NodeWidth(node);
                var depth = NodeDepth(node);
                var imageY = ImageY(node);
                var isRoot = node.Id == RootId;
                var isSelected = SelectedNodeIds.Contains(node.Id) && ImageSelectedNodeId != node.Id;
                <g class="svg-topic @(isRoot ? "svg-root" : depth == 1 ? "svg-child" : "svg-descendant") @(isSelected ? "svg-selected" : "") @(node.Id == ConnectingTargetId ? "connect-target" : "")"
                   @onclick:stopPropagation @onclick="e => Select(node, e.CtrlKey, e.ShiftKey)"
                   @ondblclick:stopPropagation @ondblclick="() => BeginEdit(node)"
                   @onpointerdown:stopPropagation @onpointerdown:preventDefault
                   @onpointerdown="e => StartDrag(e, node)">
                    @if (isSelected)
                    {
                        <rect class="selection-ring" x="@(node.X - 5)" y="@(node.Y - 5)"
                              width="@(width + 10)" height="@(height + 10)" rx="17" />
                    }
                    @if (node.Id == EditingNodeId)
                    {
                        <rect class="editing-ring" x="@(node.X - 7)" y="@(node.Y - 7)"
                              width="@(width + 14)" height="@(height + 14)" rx="18" />
                    }
                    <rect class="topic-box" x="@node.X" y="@node.Y" width="@width" height="@height" rx="12" />
                    @if (!string.IsNullOrWhiteSpace(node.ImageDataUrl))
                    {
                        <rect class="image-background" x="@(node.X + 10)" y="@imageY" width="@(width - 20)" height="@node.ImageHeight" rx="7" />
                        <image class="topic-image" href="@node.ImageDataUrl" x="@(node.X + 10)" y="@imageY"
                               width="@(width - 20)" height="@node.ImageHeight" preserveAspectRatio="none"
                               @onpointerdown:stopPropagation @onclick:stopPropagation @onclick="() => SelectImage(node)" />
                        @if (ImageSelectedNodeId == node.Id)
                        {
                            <rect class="image-selection" x="@(node.X + 7)" y="@(imageY - 3)" width="@(width - 14)" height="@(node.ImageHeight + 6)" rx="8" />
                            <rect class="resize-handle nw" x="@(node.X + 2)" y="@(imageY - 8)" width="10" height="10"
                                  @onpointerdown:stopPropagation @onpointerdown:preventDefault @onpointerdown="e => StartImageResize(e, node, 0)" />
                            <rect class="resize-handle ne" x="@(node.X + width - 12)" y="@(imageY - 8)" width="10" height="10"
                                  @onpointerdown:stopPropagation @onpointerdown:preventDefault @onpointerdown="e => StartImageResize(e, node, 1)" />
                            <rect class="resize-handle sw" x="@(node.X + 2)" y="@(imageY + node.ImageHeight - 2)" width="10" height="10"
                                  @onpointerdown:stopPropagation @onpointerdown:preventDefault @onpointerdown="e => StartImageResize(e, node, 2)" />
                            <rect class="resize-handle se" x="@(node.X + width - 12)" y="@(imageY + node.ImageHeight - 2)" width="10" height="10"
                                  @onpointerdown:stopPropagation @onpointerdown:preventDefault @onpointerdown="e => StartImageResize(e, node, 3)" />
                        }
                    }
                    @SvgText("topic-text", TopicTextX(node, width), TextBaseline(node, height),
                        DisplayText(node.Text), FontSize(node) * 1.25, TopicTextColor(node), FontSize(node), depth == 0 ? "700" : "650", depth == 0 ? "middle" : "start")
                    @if (node.Priority is >= 1 and <= 6)
                    {
                        var badgeCenterY = TextBaseline(node, height) - FontSize(node) * .35;
                        <rect class="priority-badge @(SelectedBadgeNodeId == node.Id ? "badge-selected" : "")"
                              fill="@PriorityColor(node.Priority)" stroke="@(SelectedBadgeNodeId == node.Id ? "#202938" : "none")"
                              stroke-width="2" x="@(node.X + 10)" y="@(badgeCenterY - 10)" width="20" height="20" rx="4"
                              @onclick:stopPropagation @onclick="() => SelectBadge(node)" />
                        @SvgText("priority-number", node.X + 20, badgeCenterY + 5, node.Priority.ToString(), 16, "#ffffff")
                    }
                    @if (!string.IsNullOrWhiteSpace(EffectiveLink(node)))
                    {
                        var linkCenterY = TextBaseline(node, height) - FontSize(node) * .35;
                        var linkX = node.X + 10 + (node.Priority > 0 ? 27 : 0);
                        <g class="youtube-link" @onpointerdown:stopPropagation @onclick:stopPropagation @onclick="() => OpenLink(node)">
                            <rect x="@linkX" y="@(linkCenterY - 8)" width="22" height="16" rx="4" fill="@(IsYoutubeLink(EffectiveLink(node)) ? "#ff0000" : "#2878d0")" />
                            @if (IsYoutubeLink(EffectiveLink(node)))
                            {
                                <polygon points="@(linkX + 9),@(linkCenterY - 4) @(linkX + 9),@(linkCenterY + 4) @(linkX + 16),@linkCenterY" fill="#ffffff" />
                            }
                            else
                            {
                                @SvgText("link-arrow", linkX + 11, linkCenterY + 5, "↗", 14, "#ffffff")
                            }
                        </g>
                    }
                    @if (LayoutMode == "logic" && depth >= 1 && Nodes.Any(child => child.ParentId == node.Id))
                    {
                        var toggleX = node.X + width + 13;
                        var toggleY = node.Y + height / 2;
                        <g class="collapse-toggle" @onpointerdown:stopPropagation @onclick:stopPropagation @onclick="() => ToggleCollapse(node)">
                            <circle cx="@toggleX" cy="@toggleY" r="8" fill="#ffffff" stroke="#4d8fe6" stroke-width="1.5" />
                            <line x1="@(toggleX - 4)" y1="@toggleY" x2="@(toggleX + 4)" y2="@toggleY" stroke="#347bd6" stroke-width="1.5" />
                            @if (node.IsCollapsed)
                            {
                                <line x1="@toggleX" y1="@(toggleY - 4)" x2="@toggleX" y2="@(toggleY + 4)" stroke="#347bd6" stroke-width="1.5" />
                            }
                        </g>
                    }
                </g>
            }
            @if (IsRangeSelecting)
            {
                <rect class="range-selection" x="@RangeSelectionX" y="@RangeSelectionY"
                      width="@RangeSelectionWidth" height="@RangeSelectionHeight" />
            }
        </svg>

        @if (EditingNode is not null)
        {
            <textarea @ref="EditorElement" class="node-editor" value="@EditingNode.Text"
                   @oninput="e => UpdateEditingText(e.Value?.ToString())"
                   @onkeydown="EditorKeyDown" @onkeydown:stopPropagation
                   aria-label="トピックを編集中"></textarea>
        }

        <aside class="help-card">
            <strong>スクリーンショットの貼り付け</strong>
            <span>トピックを選択して <kbd>Ctrl</kbd> + <kbd>V</kbd></span>
            <span class="paste-ready @(PasteReady ? "ready" : "not-ready")">@(PasteReady ? "● 貼り付け準備完了" : "● 貼り付け機能を準備中")</span>
        </aside>

        <div class="zoom-control" @onpointerdown:stopPropagation>
            <button @onclick="ResetViewport" title="表示位置と倍率を元に戻す">100%</button>
            <input type="range" min="40" max="250" step="10" value="@ZoomPercent"
                   @oninput="ChangeZoom" aria-label="ズーム倍率" />
            <span>@ZoomPercent%</span>
        </div>
    </section>
</div>

@code {
    private readonly JsonSerializerOptions JsonOptions = new() { WriteIndented = true, PropertyNameCaseInsensitive = true };
    private List<MindNode> Nodes = [];
    private Guid? SelectedId;
    private readonly HashSet<Guid> SelectedNodeIds = [];
    private HashSet<Guid> RangeSelectionBaseIds = [];
    private Guid? RangeSelectionBaseActiveId;
    private bool IsRangeSelecting;
    private bool SuppressNextCanvasClick;
    private double RangeSelectionStartX;
    private double RangeSelectionStartY;
    private double RangeSelectionCurrentX;
    private double RangeSelectionCurrentY;
    private Guid RootId;
    private DotNetObjectReference<Home>? SelfReference;
    private ElementReference CanvasElement;
    private ElementReference EditorElement;
    private Guid? EditingNodeId;
    private string EditOriginalText = "";
    private double EditOriginalWidth;
    private bool FocusEditorPending;
    private Guid? DraggingNodeId;
    private Guid? ConnectingTargetId;
    private Guid? SelectedBadgeNodeId;
    private Guid? ImageSelectedNodeId;
    private double Zoom = 1;
    private double MindZoom = 1;
    private double LogicZoom = 1;
    private double ViewX;
    private double ViewY;
    private string LayoutMode = "mind";
    private string SaveFolderName = "";
    private string DocumentName = "mind-map";
    private string SelectedFolderFile = "";
    private List<string> FolderFiles = [];
    private string Status = "トピックを選択してください";
    private bool PasteReady;
    private MindNode? SelectedNode => SelectedId is null ? null : Find(SelectedId.Value);
    private MindNode? EditingNode => EditingNodeId is null ? null : Find(EditingNodeId.Value);
    private IEnumerable<MindNode> VisibleNodes => Nodes.Where(IsNodeVisible);
    private double ViewWidth => 1600 / Zoom;
    private double ViewHeight => 900 / Zoom;
    private int ZoomPercent => (int)Math.Round(Zoom * 100);
    private string ViewBox => FormattableString.Invariant($"{ViewX} {ViewY} {ViewWidth} {ViewHeight}");
    private double RangeSelectionX => Math.Min(RangeSelectionStartX, RangeSelectionCurrentX);
    private double RangeSelectionY => Math.Min(RangeSelectionStartY, RangeSelectionCurrentY);
    private double RangeSelectionWidth => Math.Abs(RangeSelectionCurrentX - RangeSelectionStartX);
    private double RangeSelectionHeight => Math.Abs(RangeSelectionCurrentY - RangeSelectionStartY);

    protected override async Task OnInitializedAsync()
    {
        CreateInitialMap();
        try
        {
            var json = await JS.InvokeAsync<string?>("mindCanvas.loadLocal");
            if (!string.IsNullOrWhiteSpace(json)) LoadJson(json);
        }
        catch { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            SelfReference = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("mindCanvas.initialize", SelfReference);
        }
        if (FocusEditorPending && EditingNode is { } node)
        {
            FocusEditorPending = false;
            await JS.InvokeVoidAsync("mindCanvas.showEditor", CanvasElement, EditorElement,
                node.X, node.Y, NodeWidth(node), NodeHeight(node), FontSize(node), node.Id == RootId ? "center" : "left");
        }
    }

    private void CreateInitialMap()
    {
        var root = new MindNode { Text = "中心トピック", X = 670, Y = 365, Width = 210 };
        RootId = root.Id;
        Nodes = [root];
        SelectOnly(root.Id);
    }

    private void AddChild()
    {
        var parent = SelectedNode;
        if (parent is null) return;
        parent.IsCollapsed = false;
        var children = Nodes.Where(n => n.ParentId == parent.Id).ToList();
        var direction = parent.X + NodeWidth(parent) / 2 < Find(RootId)!.X + NodeWidth(Find(RootId)!) / 2 ? -1 : 1;
        if (parent.Id == RootId)
        {
            var leftCount = children.Count(n => n.X < parent.X);
            var rightCount = children.Count - leftCount;
            direction = rightCount <= leftCount ? 1 : -1;
        }
        var child = new MindNode {
            Text = "新しいトピック", ParentId = parent.Id,
            X = 0,
            Y = parent.Y
        };
        var childWidth = NodeWidth(child);
        const double horizontalGap = 105;
        child.X = direction > 0
            ? parent.X + NodeWidth(parent) + horizontalGap
            : parent.X - childWidth - horizontalGap;
        child.X = Math.Clamp(child.X, 30, 1570 - childWidth);

        // 親と同じ高さを最優先し、重なる場合だけ近い空き位置へ移す。
        var offsets = new[] { 0d, 85d, -85d, 170d, -170d, 255d, -255d };
        child.Y = offsets.Select(offset => Math.Clamp(parent.Y + offset, 20, 812))
            .FirstOrDefault(candidateY => !Nodes.Any(n =>
                Math.Abs(n.X - child.X) < Math.Max(NodeWidth(n), childWidth) * .75 &&
                Math.Abs(n.Y - candidateY) < 72), parent.Y);
        Nodes.Add(child);
        SelectOnly(child.Id);
        ReflowLogicTree();
        Status = "子トピックを追加しました";
    }

    private void AddSibling()
    {
        var current = SelectedNode;
        if (current is null) return;
        if (current.ParentId is null) { AddChild(); return; }
        if (Find(current.ParentId.Value) is not { } parent) return;

        var parentCenterX = parent.X + NodeWidth(parent) / 2;
        var currentIsRight = current.X + NodeWidth(current) / 2 >= parentCenterX;
        var sameSideSiblings = Nodes
            .Where(node => node.ParentId == current.ParentId &&
                (node.X + NodeWidth(node) / 2 >= parentCenterX) == currentIsRight)
            .OrderBy(node => node.Y)
            .ToList();
        var currentIndex = sameSideSiblings.FindIndex(node => node.Id == current.Id);
        var followingSiblings = currentIndex < 0
            ? []
            : sameSideSiblings.Skip(currentIndex + 1).ToList();

        const double verticalGap = 18;
        var sibling = new MindNode {
            Text = "新しいトピック", ParentId = current.ParentId,
            X = current.X,
            Y = current.Y + NodeHeight(current) + verticalGap
        };

        // 新しい兄弟を選択セルの直後へ挿入し、それより下の兄弟と各子孫を順に再配置する。
        var nextY = sibling.Y + NodeHeight(sibling) + verticalGap;
        foreach (var following in followingSiblings)
        {
            MoveSubtree(following.Id, 0, nextY - following.Y);
            nextY = following.Y + NodeHeight(following) + verticalGap;
        }
        Nodes.Add(sibling);
        SelectOnly(sibling.Id);
        SaveLayoutPositions(LayoutMode);
        Status = "選択したセルのすぐ下に兄弟トピックを追加しました";
    }

    private void ReorderSibling(bool moveUp)
    {
        var node = SelectedNode;
        if (node?.ParentId is null) return;
        var target = FindSiblingVertically(node, moveUp);
        if (target is null)
        {
            Status = moveUp ? "上に兄弟セルがありません" : "下に兄弟セルがありません";
            return;
        }
        (node.X, target.X) = (target.X, node.X);
        (node.Y, target.Y) = (target.Y, node.Y);
        Status = moveUp ? "兄弟セルを上へ移動しました" : "兄弟セルを下へ移動しました";
    }

    private void SelectSibling(bool moveUp)
    {
        var node = SelectedNode;
        if (node?.ParentId is null) return;
        var target = FindSiblingVertically(node, moveUp);
        if (target is null)
        {
            Status = moveUp ? "上に兄弟セルがありません" : "下に兄弟セルがありません";
            return;
        }
        SelectOnly(target.Id);
        Status = moveUp ? "上の兄弟セルを選択しました" : "下の兄弟セルを選択しました";
    }

    private MindNode? FindSiblingVertically(MindNode node, bool moveUp)
    {
        if (node.ParentId is null || Find(node.ParentId.Value) is not { } parent) return null;
        var nodeCenterX = node.X + NodeWidth(node) / 2;
        var nodeCenterY = node.Y + NodeHeight(node) / 2;
        var parentCenterX = parent.X + NodeWidth(parent) / 2;
        var nodeIsRight = nodeCenterX >= parentCenterX;
        return Nodes.Where(sibling => sibling.ParentId == node.ParentId && sibling.Id != node.Id)
            .Select(sibling => new
            {
                Node = sibling,
                DeltaY = sibling.Y + NodeHeight(sibling) / 2 - nodeCenterY,
                DeltaX = Math.Abs(sibling.X + NodeWidth(sibling) / 2 - nodeCenterX),
                IsRight = sibling.X + NodeWidth(sibling) / 2 >= parentCenterX
            })
            .Where(candidate => candidate.IsRight == nodeIsRight)
            .Where(candidate => moveUp ? candidate.DeltaY < -1 : candidate.DeltaY > 1)
            .OrderBy(candidate => Math.Abs(candidate.DeltaY))
            .ThenBy(candidate => candidate.DeltaX)
            .Select(candidate => candidate.Node)
            .FirstOrDefault();
    }

    private void SelectParentOrChild(bool arrowRight)
    {
        var node = SelectedNode;
        var root = Find(RootId);
        if (node is null || root is null) return;

        if (node.Id == RootId)
        {
            var child = Nodes.Where(n => n.ParentId == node.Id)
                .Where(n => arrowRight ? n.X >= node.X : n.X < node.X)
                .OrderBy(n => Math.Abs(n.Y - node.Y)).FirstOrDefault();
            if (child is not null) SelectOnly(child.Id);
            Status = child is null ? "その方向に子セルがありません" : "子セルへ選択を移動しました";
            return;
        }

        var nodeIsRight = node.X + NodeWidth(node) / 2 >= root.X + NodeWidth(root) / 2;
        var towardRoot = arrowRight != nodeIsRight;
        if (towardRoot)
        {
            if (node.ParentId is not null) SelectOnly(node.ParentId);
            Status = "親セルへ選択を移動しました";
            return;
        }

        var nearestChild = Nodes.Where(n => n.ParentId == node.Id)
            .OrderBy(n => Math.Abs(n.Y - node.Y)).FirstOrDefault();
        if (nearestChild is not null) SelectOnly(nearestChild.Id);
        Status = nearestChild is null ? "子セルがありません" : "子セルへ選択を移動しました";
    }

    // 矢印方向に直接接続された親子セルを、ツリー上の位置ごと入れ替える。
    private void SwapParentChild(bool arrowRight)
    {
        var node = SelectedNode;
        if (node is null || node.Id == RootId) return;
        var nodeCenterX = node.X + NodeWidth(node) / 2;
        var connected = Nodes.Where(candidate =>
                candidate.Id == node.ParentId || candidate.ParentId == node.Id)
            .Where(candidate => arrowRight
                ? candidate.X + NodeWidth(candidate) / 2 > nodeCenterX
                : candidate.X + NodeWidth(candidate) / 2 < nodeCenterX)
            .OrderBy(candidate => Math.Abs((candidate.X + NodeWidth(candidate) / 2) - nodeCenterX))
            .ThenBy(candidate => Math.Abs(candidate.Y - node.Y))
            .FirstOrDefault();

        if (connected is null)
        {
            Status = "その方向に直接接続された親子セルがありません";
            return;
        }
        if (connected.Id == RootId)
        {
            Status = "中心トピックとの入れ替えはできません";
            return;
        }

        var parent = node.ParentId == connected.Id ? connected : node;
        var child = parent.Id == node.Id ? connected : node;
        if (child.ParentId != parent.Id) return;

        var grandParentId = parent.ParentId;
        child.ParentId = grandParentId;
        parent.ParentId = child.Id;
        (parent.X, child.X) = (child.X, parent.X);
        (parent.Y, child.Y) = (child.Y, parent.Y);
        SelectOnly(node.Id);
        Status = "親セルと子セルを入れ替えました";
    }

    private HashSet<Guid> DescendantIds(Guid rootId)
    {
        var ids = new HashSet<Guid> { rootId };
        while (Nodes.Any(n => n.ParentId is not null && ids.Contains(n.ParentId.Value) && ids.Add(n.Id))) { }
        return ids;
    }

    private void DeleteSelected()
    {
        var selected = Nodes.Where(node => SelectedNodeIds.Contains(node.Id) && node.Id != RootId).ToList();
        if (selected.Count == 0) return;
        var fallbackId = SelectedNode?.ParentId;
        var ids = selected.Select(node => node.Id).ToHashSet();
        while (Nodes.Any(node => node.ParentId is not null && ids.Contains(node.ParentId.Value) && ids.Add(node.Id))) { }
        var removedCount = ids.Count;
        Nodes.RemoveAll(n => ids.Contains(n.Id));
        SelectOnly(fallbackId is not null && Nodes.Any(node => node.Id == fallbackId) ? fallbackId : RootId);
        ReflowLogicTree();
        Status = removedCount == 1 ? "トピックを削除しました" : $"選択したトピックをまとめて削除しました（{removedCount}件）";
    }

    private void DeleteConnector(MindNode child)
    {
        child.ParentId = null;
        SelectOnly(child.Id);
        Status = "コネクターを削除しました（セルは残っています）";
    }

    private void SetPriority(int priority)
    {
        if (SelectedNode is null || priority is < 1 or > 6) return;
        SelectedNode.Priority = SelectedNode.Priority == priority ? 0 : priority;
        SelectedBadgeNodeId = SelectedNode.Priority == 0 ? null : SelectedNode.Id;
        ReflowLogicTree();
        Status = SelectedNode.Priority == 0 ? "優先度バッジを解除しました" : $"優先度 {priority} を設定しました";
    }

    private void SelectBadge(MindNode node)
    {
        ImageSelectedNodeId = null;
        SelectOnly(node.Id);
        SelectedBadgeNodeId = node.Id;
        Status = "バッジを選択しました。Deleteキーで削除できます";
    }

    private static string PriorityColor(int priority) => priority switch
    {
        1 => "#ef4444", 2 => "#f59e0b", 3 => "#3b82f6",
        4 => "#10b981", 5 => "#56a3a6", 6 => "#7aa6a8", _ => "#78909c"
    };
    private static string? EffectiveLink(MindNode node) => string.IsNullOrWhiteSpace(node.LinkUrl) ? node.YoutubeUrl : node.LinkUrl;
    private static bool IsYoutubeLink(string? url) => !string.IsNullOrWhiteSpace(url) &&
        (url.Contains("youtube.com", StringComparison.OrdinalIgnoreCase) || url.Contains("youtu.be", StringComparison.OrdinalIgnoreCase));

    private void SelectImage(MindNode node)
    {
        SelectedBadgeNodeId = null;
        SelectOnly(node.Id);
        ImageSelectedNodeId = node.Id;
        Status = "画像を選択しました。角をドラッグしてサイズ変更、Alt+↑↓で文字との順序を変更できます";
    }

    private void Select(MindNode node, bool ctrlKey, bool shiftKey)
    {
        if (EditingNodeId is not null) EndEdit();
        SelectedBadgeNodeId = null;
        ImageSelectedNodeId = null;

        if (ctrlKey)
        {
            if (!SelectedNodeIds.Add(node.Id))
            {
                SelectedNodeIds.Remove(node.Id);
                if (SelectedId == node.Id)
                    SelectedId = Nodes.LastOrDefault(candidate => SelectedNodeIds.Contains(candidate.Id))?.Id;
            }
            else
            {
                SelectedId = node.Id;
            }
        }
        else if (shiftKey)
        {
            SelectedNodeIds.Add(node.Id);
            SelectedId = node.Id;
        }
        else
        {
            SelectOnly(node.Id);
        }

        Status = SelectedNodeIds.Count switch
        {
            0 => "トピックを選択してください",
            1 => "閲覧モード：ドラッグで移動、F2で編集",
            _ => $"{SelectedNodeIds.Count}個のトピックを選択しています"
        };
    }

    private void SelectOnly(Guid? nodeId)
    {
        SelectedNodeIds.Clear();
        SelectedId = nodeId;
        if (nodeId is not null) SelectedNodeIds.Add(nodeId.Value);
    }

    private void HandleCanvasClick()
    {
        if (SuppressNextCanvasClick)
        {
            SuppressNextCanvasClick = false;
            return;
        }
        ClearSelection();
    }

    private void ClearSelection()
    {
        if (EditingNodeId is not null) EndEdit();
        SelectedBadgeNodeId = null;
        ImageSelectedNodeId = null;
        SelectOnly(null);
        Status = "トピックを選択してください";
    }
    private MindNode? Find(Guid id) => Nodes.FirstOrDefault(n => n.Id == id);
    private double NodeHeight(MindNode node)
    {
        var additionalLines = Math.Max(0, TextLineCount(node.Text) - 1);
        if (!string.IsNullOrWhiteSpace(node.ImageDataUrl)) return node.ImageHeight + 60 + additionalLines * FontSize(node) * 1.25;
        var baseHeight = NodeDepth(node) switch { 0 => 68, 1 => 50, _ => 52 };
        return baseHeight + additionalLines * FontSize(node) * 1.25;
    }
    private int NodeDepth(MindNode node)
    {
        var depth = 0;
        var parentId = node.ParentId;
        while (parentId is not null && Find(parentId.Value) is { } parent)
        { depth++; parentId = parent.ParentId; }
        return depth;
    }
    private double FontSize(MindNode node) => NodeDepth(node) switch { 0 => 24, 1 => 18, _ => 15 };
    private string TopicTextColor(MindNode node) => NodeDepth(node) <= 1 ? "#124f83" : "#30394d";
    private double TopicTextX(MindNode node, double width)
    {
        if (NodeDepth(node) == 0)
            return node.X + width / 2 + (node.Priority > 0 ? 10 : 0) + (!string.IsNullOrWhiteSpace(EffectiveLink(node)) ? 10 : 0);
        return node.X + 12 + (node.Priority > 0 ? 30 : 0) + (!string.IsNullOrWhiteSpace(EffectiveLink(node)) ? 30 : 0);
    }
    private static int TextLineCount(string text) => text.Replace("\r", "").Split('\n').Length;
    private double TextBaseline(MindNode node, double height)
    {
        var lines = TextLineCount(node.Text);
        var lineHeight = FontSize(node) * 1.25;
        if (!string.IsNullOrWhiteSpace(node.ImageDataUrl))
        {
            if (node.ImageAboveText) return node.Y + node.ImageHeight + 40 - (lines - 1) * lineHeight;
            var textAreaHeight = 60 + (lines - 1) * lineHeight;
            return node.Y + textAreaHeight / 2 - (lines - 1) * lineHeight / 2 + FontSize(node) * .35;
        }
        return node.Y + height / 2 - (lines - 1) * lineHeight / 2 + FontSize(node) * .35;
    }
    private double ImageY(MindNode node)
    {
        if (node.ImageAboveText) return node.Y + 10;
        var lineHeight = FontSize(node) * 1.25;
        var textAreaHeight = 60 + Math.Max(0, TextLineCount(node.Text) - 1) * lineHeight;
        return node.Y + textAreaHeight - 10;
    }
    private double NodeWidth(MindNode node)
    {
        if (!string.IsNullOrWhiteSpace(node.ImageDataUrl)) return Math.Max(160, node.Width);
        var fontSize = FontSize(node);
        var longestLineWidth = node.Text.Replace("\r", "").Split('\n')
            .Select(line => line.Sum(character => character <= 0x7f ? fontSize * .56 : fontSize * .98))
            .DefaultIfEmpty(0).Max();
        var horizontalPadding = NodeDepth(node) switch { 0 => 34, 1 => 28, _ => 24 };
        var badgeWidth = node.Priority > 0 ? 30 : 0;
        var linkWidth = !string.IsNullOrWhiteSpace(EffectiveLink(node)) ? 30 : 0;
        var minimum = NodeDepth(node) switch { 0 => 110, 1 => 58, _ => 42 };
        return Math.Clamp(longestLineWidth + horizontalPadding + badgeWidth + linkWidth, minimum, 420);
    }
    private string BranchPath(MindNode p, MindNode n)
    {
        var parentWidth = NodeWidth(p);
        var nodeWidth = NodeWidth(n);
        var fromRight = n.X + nodeWidth / 2 >= p.X + parentWidth / 2;
        var x1 = fromRight ? p.X + parentWidth : p.X;
        var y1 = p.Y + NodeHeight(p) / 2;
        var x2 = fromRight ? n.X : n.X + nodeWidth;
        var y2 = n.Y + NodeHeight(n) / 2;
        var mid = (x1 + x2) / 2;
        if (LayoutMode == "logic") return $"M {x1} {y1} H {mid} V {y2} H {x2}";
        return $"M {x1} {y1} C {mid} {y1}, {mid} {y2}, {x2} {y2}";
    }

    private void ChangeLayoutMode(string mode)
    {
        if (mode is not ("mind" or "logic")) return;
        if (mode == LayoutMode) return;
        SaveLayoutPositions(LayoutMode);
        SaveCurrentModeZoom();
        LayoutMode = mode;
        if (mode == "logic")
        {
            ApplyAutomaticLayout();
            SaveLayoutPositions(mode);
        }
        else
        {
            RestoreMindMapPositionsAndPlaceNewNodes();
        }
        RestoreModeZoom(mode);
        Status = mode == "mind" ? "マインドマップモードへ切り替えました" : "ロジックツリーモードへ切り替えました";
    }
    private void ChangeToMindMap() => ChangeLayoutMode("mind");
    private void ChangeToLogicTree() => ChangeLayoutMode("logic");

    private void SaveLayoutPositions(string mode)
    {
        foreach (var node in Nodes)
        {
            if (mode == "logic") { node.LogicX = node.X; node.LogicY = node.Y; }
            else { node.MindX = node.X; node.MindY = node.Y; }
        }
    }

    private void SaveCurrentModeZoom()
    {
        if (LayoutMode == "logic") LogicZoom = NormalizeZoom(Zoom);
        else MindZoom = NormalizeZoom(Zoom);
    }

    private void RestoreModeZoom(string mode)
    {
        Zoom = NormalizeZoom(mode == "logic" ? LogicZoom : MindZoom);
        ViewX = 0;
        ViewY = 0;
    }

    private static double NormalizeZoom(double zoom)
        => double.IsFinite(zoom) && zoom > 0 ? Math.Clamp(zoom, .4, 2.5) : 1;

    private void RestoreMindMapPositionsAndPlaceNewNodes()
    {
        if (Nodes.Count == 0) return;
        var positionedIds = Nodes
            .Where(node => node.MindX is not null && node.MindY is not null)
            .Select(node => node.Id)
            .ToHashSet();

        // 保存済みのマインドマップ座標は一切動かさず、そのまま復元する。
        foreach (var node in Nodes.Where(node => positionedIds.Contains(node.Id)))
        {
            node.X = node.MindX!.Value;
            node.Y = node.MindY!.Value;
        }

        // 以前のマインドマップ座標が1件もない古いデータだけは、従来どおり全体配置する。
        if (positionedIds.Count == 0)
        {
            ApplyAutomaticLayout();
            SaveLayoutPositions("mind");
            return;
        }

        if (!positionedIds.Contains(RootId) && Find(RootId) is { } rootWithoutPosition)
        {
            rootWithoutPosition.X = 800 - NodeWidth(rootWithoutPosition) / 2;
            rootWithoutPosition.Y = 450 - NodeHeight(rootWithoutPosition) / 2;
            positionedIds.Add(rootWithoutPosition.Id);
        }

        // ロジックツリーで追加されたセルだけを、復元済みの親の近くにある空き位置へ置く。
        foreach (var node in Nodes.Where(node => !positionedIds.Contains(node.Id)).OrderBy(NodeDepth).ToList())
        {
            PlaceNewMindMapNode(node, positionedIds);
            positionedIds.Add(node.Id);
        }

        SaveLayoutPositions("mind");
        Zoom = 1;
        ViewX = 0;
        ViewY = 0;
    }

    private void PlaceNewMindMapNode(MindNode node, HashSet<Guid> positionedIds)
    {
        var root = Find(RootId);
        var parent = node.ParentId is not null ? Find(node.ParentId.Value) : root;
        if (root is null || parent is null)
        {
            node.X = 800;
            node.Y = 450;
            return;
        }

        int direction;
        if (parent.Id == RootId)
        {
            var rootCenterX = root.X + NodeWidth(root) / 2;
            var positionedChildren = Nodes.Where(candidate =>
                positionedIds.Contains(candidate.Id) && candidate.ParentId == root.Id).ToList();
            var leftCount = positionedChildren.Count(candidate => candidate.X + NodeWidth(candidate) / 2 < rootCenterX);
            direction = positionedChildren.Count - leftCount <= leftCount ? 1 : -1;
        }
        else
        {
            direction = parent.X + NodeWidth(parent) / 2 >= root.X + NodeWidth(root) / 2 ? 1 : -1;
        }

        const double horizontalGap = 90;
        var nodeWidth = NodeWidth(node);
        node.X = direction > 0
            ? parent.X + NodeWidth(parent) + horizontalGap
            : parent.X - nodeWidth - horizontalGap;

        var baseY = parent.Y + (NodeHeight(parent) - NodeHeight(node)) / 2;
        var verticalStep = Math.Max(74, NodeHeight(node) + 22);
        var maxAttempts = Math.Max(16, Nodes.Count * 4);
        for (var attempt = 0; attempt < maxAttempts; attempt++)
        {
            var ring = (attempt + 1) / 2;
            var offset = attempt == 0 ? 0 : (attempt % 2 == 1 ? ring : -ring) * verticalStep;
            var candidateY = baseY + offset;
            if (!OverlapsPositionedNode(node, node.X, candidateY, positionedIds))
            {
                node.Y = candidateY;
                return;
            }
        }

        node.Y = baseY + (maxAttempts + 1) * verticalStep;
    }

    private bool OverlapsPositionedNode(MindNode node, double x, double y, HashSet<Guid> positionedIds)
    {
        const double horizontalMargin = 24;
        const double verticalMargin = 18;
        var width = NodeWidth(node);
        var height = NodeHeight(node);
        return Nodes.Where(other => positionedIds.Contains(other.Id)).Any(other =>
            x < other.X + NodeWidth(other) + horizontalMargin &&
            x + width + horizontalMargin > other.X &&
            y < other.Y + NodeHeight(other) + verticalMargin &&
            y + height + verticalMargin > other.Y);
    }

    private void ApplyAutomaticLayout()
    {
        var root = Find(RootId);
        if (root is null) return;
        if (LayoutMode == "logic") ApplyLogicTreeLayout(root);
        else ApplyMindMapLayout(root);
        Zoom = 1;
        ViewX = 0;
        ViewY = 0;
    }

    private int LeafWeight(MindNode node)
    {
        var children = LayoutChildren(node);
        return children.Count == 0 ? 1 : children.Sum(LeafWeight);
    }

    private List<MindNode> LayoutChildren(MindNode node)
    {
        if (LayoutMode == "logic" && node.IsCollapsed) return [];
        return Nodes.Where(candidate => candidate.ParentId == node.Id).ToList();
    }

    private bool IsNodeVisible(MindNode node)
    {
        if (LayoutMode != "logic") return true;
        var parentId = node.ParentId;
        while (parentId is not null && Find(parentId.Value) is { } parent)
        {
            if (parent.IsCollapsed) return false;
            parentId = parent.ParentId;
        }
        return true;
    }

    private void ToggleCollapse(MindNode node)
    {
        node.IsCollapsed = !node.IsCollapsed;
        SelectOnly(node.Id);
        if (Find(RootId) is { } root) ApplyLogicTreeLayout(root);
        SaveLayoutPositions("logic");
        Status = node.IsCollapsed ? "配下のセルを折りたたみました" : "配下のセルを展開しました";
    }

    private void ApplyMindMapLayout(MindNode root)
    {
        root.X = 800 - NodeWidth(root) / 2;
        root.Y = 450 - NodeHeight(root) / 2;
        var children = LayoutChildren(root).OrderBy(n => n.Y).ToList();
        var left = children.Where(n => n.X + NodeWidth(n) / 2 < root.X + NodeWidth(root) / 2).ToList();
        var right = children.Except(left).ToList();
        if (left.Count == 0 && right.Count > 1)
        {
            left = right.Where((_, index) => index % 2 == 1).ToList();
            right = right.Except(left).ToList();
        }
        LayoutMindSide(root, left, -1);
        LayoutMindSide(root, right, 1);
    }

    private void LayoutMindSide(MindNode root, List<MindNode> children, int direction)
    {
        if (children.Count == 0) return;
        var totalWeight = children.Sum(LeafWeight);
        var totalHeight = Math.Min(780, Math.Max(100, totalWeight * 92));
        var top = 450 - totalHeight / 2;
        var used = 0d;
        foreach (var child in children)
        {
            var span = totalHeight * LeafWeight(child) / totalWeight;
            var x = direction > 0 ? root.X + NodeWidth(root) + 105 : root.X - NodeWidth(child) - 105;
            LayoutMindSubtree(child, x, top + used, span, direction, 1);
            used += span;
        }
    }

    private void LayoutMindSubtree(MindNode node, double x, double top, double span, int direction, int depth)
    {
        node.X = x;
        node.Y = top + span / 2 - NodeHeight(node) / 2;
        var children = LayoutChildren(node).OrderBy(n => n.Y).ToList();
        if (children.Count == 0) return;
        var totalWeight = children.Sum(LeafWeight);
        var used = 0d;
        foreach (var child in children)
        {
            var childSpan = span * LeafWeight(child) / totalWeight;
            var childX = direction > 0 ? node.X + NodeWidth(node) + 90 : node.X - NodeWidth(child) - 90;
            LayoutMindSubtree(child, childX, top + used, childSpan, direction, depth + 1);
            used += childSpan;
        }
    }

    private void ApplyLogicTreeLayout(MindNode root)
    {
        var depthWidths = VisibleNodes.GroupBy(NodeDepth).ToDictionary(group => group.Key, group => group.Max(NodeWidth));
        var depthX = new Dictionary<int, double> { [0] = 60 };
        for (var depth = 1; depth <= depthWidths.Keys.DefaultIfEmpty(0).Max(); depth++)
            depthX[depth] = depthX[depth - 1] + depthWidths.GetValueOrDefault(depth - 1, 120) + 28;
        var totalHeight = LogicSubtreeHeight(root);
        var top = totalHeight < 840 ? (900 - totalHeight) / 2 : 30;
        LayoutLogicSubtree(root, depthX, top, totalHeight, 0);
    }

    private double LogicSubtreeHeight(MindNode node)
    {
        var children = LayoutChildren(node).OrderBy(n => n.Y).ToList();
        if (children.Count == 0) return NodeHeight(node);
        const double verticalGap = 22;
        var childrenHeight = children.Sum(LogicSubtreeHeight) + verticalGap * (children.Count - 1);
        return Math.Max(NodeHeight(node), childrenHeight);
    }

    private void LayoutLogicSubtree(MindNode node, Dictionary<int, double> depthX, double top, double subtreeHeight, int depth)
    {
        node.X = depthX.GetValueOrDefault(depth, 60);
        node.Y = top + (subtreeHeight - NodeHeight(node)) / 2;
        var children = LayoutChildren(node).OrderBy(n => n.Y).ToList();
        if (children.Count == 0) return;
        const double verticalGap = 22;
        var childHeights = children.ToDictionary(child => child.Id, LogicSubtreeHeight);
        var childrenHeight = childHeights.Values.Sum() + verticalGap * (children.Count - 1);
        var childTop = top + (subtreeHeight - childrenHeight) / 2;
        foreach (var child in children)
        {
            var childHeight = childHeights[child.Id];
            LayoutLogicSubtree(child, depthX, childTop, childHeight, depth + 1);
            childTop += childHeight + verticalGap;
        }
    }

    private void ReflowLogicTree()
    {
        if (LayoutMode == "logic" && Find(RootId) is { } root)
        {
            ApplyLogicTreeLayout(root);
            SaveLayoutPositions("logic");
        }
    }

